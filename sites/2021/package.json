{
  "name": "ase2021.jaredreisinger.com",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm-run-all --print-label --parallel css eleventy browsersync",
    "dev": "npm-run-all --print-label --parallel css:watch eleventy:watch browsersync:watch",
    "css": "npm -w @ase/eleventy-shared run css",
    "css:watch": "npm -w @ase/eleventy-shared run css:watch",
    "eleventy": "npm -w @ase/eleventy-shared run build && eleventy",
    "eleventy:watch": "npm run eleventy -- --watch",
    "eleventy:debug": "cross-env DEBUG=* npm run eleventy",
    "browsersync": "browser-sync start --server _site --files _site --port 8080 --no-notify --no-open",
    "browsersync:watch": "npm run browsersync -- --watch --reload-delay 50",
    "build": "npm run css && cross-env NODE_ENV=production npm run eleventy",
    "clean": "rimraf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-navigation": "^1.0.5",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.1.0",
    "npm-run-all": "^4.1.5",
    "rimraf": "^6.1.3"
  },
  "dependencies": {
    "@ase/eleventy-shared": "^0.0.0"
  }
}
