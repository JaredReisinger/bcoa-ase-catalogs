{
  "name": "ase2023.basenji.org",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm-run-all --print-label --parallel css eleventy browsersync",
    "dev": "npm-run-all --print-label --parallel css:watch eleventy:watch browsersync:watch",
    "css": "postcss src/static/css/tailwind.css --o _site/static/css/style.css",
    "css:watch": "npm run css -- --watch",
    "eleventy": "eleventy",
    "eleventy:watch": "npm run eleventy -- --watch",
    "eleventy:debug": "cross-env DEBUG=* eleventy",
    "browsersync": "browser-sync start --server _site --files _site --port 8080 --no-notify --no-open",
    "browsersync:watch": "npm run browsersync -- --watch --reload-delay 50",
    "build": "npm run css && cross-env NODE_ENV=production npm run eleventy",
    "clean": "rimraf _site"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@11ty/eleventy-navigation": "^1.0.5",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "alpinejs": "^3.17.4",
    "browser-sync": "^3.0.4",
    "cross-env": "^10.1.0",
    "cssnano": "^9.1.2",
    "html-minifier": "^4.0.0",
    "inflection": "^3.0.2",
    "js-yaml": "^5.4.2",
    "luxon": "^3.7.2",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.28",
    "postcss-cli": "^12.0.0",
    "postcss-nested": "^8.0.1",
    "rimraf": "^6.1.3",
    "tailwindcss": "^4.3.3"
  }
}
